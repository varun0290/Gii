<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_view_form_inherit_fs" model="ir.ui.view">
        <field name="name">hr.contract.view.form.inherit.fs</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            
            <!-- Replace Header -->
            <xpath expr="//header" position="replace">
                <header>
                    <button name="action_submit_for_approval" string="Submit for Approval" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_approve_hr" string="Approve (HR)" type="object" invisible="state != 'wait_hr'" class="oe_highlight" groups="fs_hr_contract.group_head_of_hr"/>
                    <button name="action_approve_finance" string="Approve (Finance)" type="object" invisible="state != 'wait_finance'" class="oe_highlight" groups="fs_hr_contract.group_vp_finance"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state not in ('wait_hr', 'wait_finance')" groups="fs_hr_contract.group_head_of_hr,fs_hr_contract.group_vp_finance"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state == 'draft'" groups="fs_hr_contract.group_head_of_hr,fs_hr_contract.group_vp_finance"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,close,cancel"/>
                </header>
            </xpath>

            <!-- Add Employee ID and Probation -->
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="employee_id_no"/>
                <field name="probation_period_months" readonly="state != 'draft'"/>
            </xpath>

            <!-- Add Tabs -->
            <xpath expr="//notebook" position="inside">
                <page string="Salary Structure" name="salary_structure">
                    <group>
                        <group string="1. Earnings">
                            <field name="vehicle_allowance" readonly="state != 'draft'"/>
                            <field name="fixed_telephone_allowance" readonly="state != 'draft'"/>
                            <field name="fixed_vacation_ticket_allowance" readonly="state != 'draft'"/>
                            <field name="leave_travel_allowance" readonly="state != 'draft'"/>
                            <field name="medical_insurance_allowance" readonly="state != 'draft'"/>
                            <field name="education_other_allowance" readonly="state != 'draft'"/>
                            <field name="total_earnings" decoration-bf="1"/>
                        </group>
                        <group string="2. Additions">
                            <field name="arrears" readonly="state != 'draft'"/>
                            <field name="leave_encashment" readonly="state != 'draft'"/>
                            <field name="reimbursement" readonly="state != 'draft'"/>
                            <field name="airfare" readonly="state != 'draft'"/>
                            <field name="other_additions" readonly="state != 'draft'"/>
                            <field name="total_additions" decoration-bf="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="3. Deductions">
                            <field name="leave_deduction" readonly="state != 'draft'"/>
                            <field name="late_coming_deduction" readonly="state != 'draft'"/>
                            <field name="absent_days_deduction" readonly="state != 'draft'"/>
                            <field name="loan_repayment" readonly="state != 'draft'"/>
                            <field name="gosi_deduction" readonly="state != 'draft'"/>
                            <field name="other_deductions" readonly="state != 'draft'"/>
                            <field name="vehicle_allowance_deduction" readonly="state != 'draft'"/>
                            <field name="recurring_deductions" readonly="state != 'draft'"/>
                            <field name="total_deductions" decoration-bf="1"/>
                        </group>
                        <group string="4. Summary">
                            <field name="gross_salary" decoration-bf="1"/>
                            <field name="net_salary" decoration-bf="1"/>
                            <field name="total_cash_compensation" decoration-bf="1"/>
                            <separator string="5. Pension" colspan="2"/>
                            <field name="employer_pension_contribution" readonly="state != 'draft'"/>
                            <field name="employee_pension_contribution" readonly="state != 'draft'"/>
                        </group>
                    </group>
                </page>
                <page string="Increment / Bonus" name="increment_bonus">
                    <group>
                        <group>
                            <field name="bonus" readonly="state != 'draft'"/>
                            <field name="special_increment" readonly="state != 'draft'"/>
                            <field name="promotion_adjustment" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="performance_incentives" readonly="state != 'draft'"/>
                            <field name="one_time_rewards" readonly="state != 'draft'"/>
                        </group>
                    </group>
                </page>
            </xpath>

            <!-- Lock Standard Fields (non-editable after submit for approval) -->
            <xpath expr="//field[@name='employee_id']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='date_start']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='date_end']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='wage']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='structure_type_id']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='resource_calendar_id']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='department_id']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='job_id']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='contract_type_id']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='notes']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='kanban_state']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='hr_responsible_id']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
