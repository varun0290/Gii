<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_contract_update_wizard_form" model="ir.ui.view">
        <field name="name">hr.contract.update.wizard.form</field>
        <field name="model">hr.contract.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Update contract">
                <group>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="employee_id"/>
                    <field name="source_contract_id" options="{'no_create': True, 'no_edit': True}"/>
                    <field name="new_wage"/>
                    <field name="effective_date_start"/>
                    <field name="effective_date_end"/>
                </group>
                <footer>
                    <button name="action_create_contract" string="Create new contract" type="object" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
