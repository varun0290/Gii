<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="fs_approval_view_move_inherited_form" model="ir.ui.view">
        <field name="name">account.move.inherit.view.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <field name="invoice_user_id" position="after">
                <field name="approval_level_id" />
                <field name="is_boolean"  invisible="1"/>
            </field>

            <xpath expr="//header" position="inside">
                <button
                    class="oe_highlight"
                    string="Approve"
                    type="object"
                    name="action_approve_order"
                    invisible="state not in ('to_approve') or is_boolean == False" />
                <button
                    string="Reject"
                    type="action"
                    name="%(fs_account_dyanamic_approval.account_sh_rejection_reason_action)d"
                    invisible="state not in ('to_approve') or is_boolean == False" />
                <button
                    string="Reset to Draft"
                    type="object"
                    name="action_reset_to_draft"
                    invisible="state not in ('reject')" />
            </xpath>

            <xpath expr="//notebook//page[@id='other_tab_entry']" position="after">
                <page string="Approval Info" name="">
                    <group>

                        <group string="Next Approval">
                            <field name="level" />
                            <field name="user_ids" widget="many2many_tags" />
                            <field name="group_ids" widget="many2many_tags" />
                        </group>

                        <group string="Reject Order Info">
                            <field name="rejection_date" />
                            <field name="reject_by" />
                            <field name="reject_reason" />
                        </group>

                        <field name="approval_info_line" nolabel="1" context="{'form_view_ref': 'fs_account_dyanamic_approval.account_sh_approval_info_view_form'}">
                            <tree>
                                <field name="level" />
                                <field name="user_ids" />
                                <field name="group_ids" />
                                <field name="status" widget="boolean_toggle" readonly="1" />
                                <field name="approval_date" />
                                <field name="approved_by" />
                                <field name="account_move_id" invisible="1" />
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <record id="fs_invoice_waiting_approval_action" model="ir.actions.act_window">
        <field name="name">Waiting Approval</field>
        <field name="res_model">account.move</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,kanban,form,pivot,graph,calendar,activity</field>
        <field name="view_id" ref="account.view_out_invoice_tree" />
        <field name="domain">[('state', '=', 'to_approve')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face"></p>
        </field>
    </record>


    <record id="fs_invoice_my_approval_action" model="ir.actions.act_window">
        <field name="name">My Approval</field>
        <field name="res_model">account.move</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,kanban,form,pivot,graph,calendar,activity</field>
        <field name="view_id" ref="account.view_out_invoice_tree" />
        <field name="domain">[('is_boolean', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face"></p>
        </field>
    </record>

    <record id="fs_bill_waiting_approval_action" model="ir.actions.act_window">
        <field name="name">Waiting Approval</field>
        <field name="res_model">account.move</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,kanban,form,pivot,graph,calendar,activity</field>
        <field name="view_id" ref="account.view_in_invoice_tree" />
        <field name="domain">[('state', '=', 'to_approve')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face"></p>
        </field>
    </record>


    <record id="fs_bill_my_approval_action" model="ir.actions.act_window">
        <field name="name">My Approval</field>
        <field name="res_model">account.move</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,kanban,form,pivot,graph,calendar,activity</field>
        <field name="view_id" ref="account.view_in_invoice_tree" />
        <field name="domain">[('is_boolean', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face"></p>
        </field>
    </record>

    <menuitem  id="sh_invoice_waiting_approval_action_menu" 
        name="Waiting Approval" 
        action="fs_invoice_waiting_approval_action"  
        parent="account.menu_finance_receivables" 
        sequence="4" />

    <menuitem id="sh_invoice_my_approval_action_menu" 
        name="My Approval" 
        action="fs_invoice_my_approval_action"  
        parent="account.menu_finance_receivables" 
        sequence="5" />

    <menuitem  id="sh_bill_waiting_approval_action_menu" 
        name="Waiting Approval" 
        action="fs_bill_waiting_approval_action"  
        parent="account.menu_finance_payables" 
        sequence="4" />

    <menuitem id="sh_bill_my_approval_action_menu" 
        name="My Approval" 
        action="fs_bill_my_approval_action"  
        parent="account.menu_finance_payables" 
        sequence="5" />
</odoo>