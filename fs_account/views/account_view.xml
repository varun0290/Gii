<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="fs_analytic_acc_view_move_form" model="ir.ui.view">
        <field name="name">fs.analytic.acc.account.move.view.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="debit_account_id" invisible="parent.move_type not in ('in_invoice', 'in_refund')"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='analytic_distribution']" position="attributes">
                <attribute name="column_invisible">parent.move_type != 'entry'</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='analytic_distribution']" position="after">
                <field name="analytic_account_id" required="parent.move_type != 'entry'" column_invisible="parent.move_type == 'entry'"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/tree/field[@name='analytic_distribution']" position="attributes">
                <attribute name="column_invisible">parent.move_type != 'entry'</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/tree/field[@name='analytic_distribution']" position="after">
                <field name="analytic_account_id" required="parent.move_type != 'entry'" column_invisible="parent.move_type == 'entry'"/>
            </xpath>
        </field>
    </record>
    <record id="view_account_search" model="ir.ui.view">
        <field name="name">account.account.search</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="group_id"/>
            </xpath>
            <xpath expr="//filter[@name='accounttype']" position="after">
                <filter string="Group" name="group" domain="" context="{'group_by':'group_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="account.action_move_journal_line" model="ir.actions.act_window">
        <field name="name">Journal Entries</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form,activity</field>
        <field name="view_id" ref="account.view_move_tree"/>
        <field name="search_view_id" ref="account.view_account_move_filter"/>
        <field name="domain">[('is_petty_cash', '=', False)]</field>
        <field name="context">{
            'default_move_type': 'entry',
            'is_journal_entry': True,
            'search_default_posted':1,
            'view_no_maturity': True,
        }</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create a journal entry
          </p><p>
            A journal entry consists of several journal items, each of
            which is either a debit or a credit transaction.
          </p>
        </field>
    </record>

    <record id="action_move_petty_cash_journal_line" model="ir.actions.act_window">
        <field name="name">Petty Cash</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form,activity</field>
        <field name="view_id" ref="account.view_move_tree"/>
        <field name="search_view_id" ref="account.view_account_move_filter"/>
        <field name="domain">[('is_petty_cash', '!=', False)]</field>
        <field name="context">{
            'default_move_type': 'entry',
            'is_petty_cash': True,
            'search_default_posted':1,
            'view_no_maturity': True,
            }</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create a journal entry
          </p><p>
            A journal entry consists of several journal items, each of
            which is either a debit or a credit transaction.
          </p>
        </field>
    </record>

    <menuitem
        id="menu_action_petty_cash"
        parent="account.menu_finance_entries_accounting_miscellaneous"
        action="action_move_petty_cash_journal_line"
        groups="account.group_account_readonly"
        sequence="11"/>

</odoo>
