<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Inherited hr employee for adding new field-->
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.hr.zk.attendance</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='identification_id']" position="attributes">
                <attribute name="help">Must match the EmployeeCode from your biometric API or device when syncing attendance.</attribute>
            </xpath>
            <xpath expr="//field[@name='employee_type']" position="after">
                <field name="device_id_num" optional="hide"
                       help="Not used for attendance sync; EmployeeCode is matched to Identification No. instead."/>
            </xpath>
        </field>
    </record>
</odoo>
