<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="biometric_device_details_view_list" model="ir.ui.view">
        <field name="name">biometric.device.details.view.tree</field>
        <field name="model">biometric.device.details</field>
        <field name="arch" type="xml">
            <tree string="Biometric integrations">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="connection_mode"/>
                <field name="last_sync_at" optional="hide"/>
                <field name="last_sync_period" optional="hide"/>
                <field name="device_ip" optional="show"/>
                <field name="port_number" optional="hide"/>
                <field name="web_api_base_url" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="biometric_device_details_view_form" model="ir.ui.view">
        <field name="name">biometric.device.details.view.form</field>
        <field name="model">biometric.device.details</field>
        <field name="arch" type="xml">
            <form string="Biometric integration">
                <header>
                    <button name="action_download_attendance"
                            string="Sync now (auto range)"
                            type="object"
                            class="btn-primary"
                            invisible="connection_mode != 'web_api'"
                            title="Uses lookback below: FromDate = today − days, ToDate = today"/>
                    <button name="action_open_fetch_by_date_wizard"
                            string="Fetch by dates…"
                            type="object"
                            class="btn-secondary"
                            invisible="connection_mode != 'web_api'"/>
                    <button name="action_download_attendance"
                            string="Download from reader"
                            type="object"
                            class="btn-primary"
                            invisible="connection_mode != 'zk'"/>
                    <button name="action_set_timezone" string="Set device time"
                            type="object" class="btn-secondary"
                            invisible="connection_mode != 'zk'"/>
                    <button name="action_clear_attendance" string="Clear reader log"
                            type="object"
                            invisible="connection_mode != 'zk'"/>
                    <button name="action_restart_device" string="Restart reader"
                            type="object"
                            confirm="Restart the biometric device?"
                            invisible="connection_mode != 'zk'"/>
                </header>
                <sheet>
                    <div class="oe_title mb-3">
                        <label for="name" string="Integration name"/>
                        <h1>
                            <field name="name" class="oe_inline text-break"
                                   placeholder="e.g. HQ — Main gate"/>
                        </h1>
                    </div>

                    <group name="web_status" string="Last synchronization (Web API)"
                           invisible="connection_mode != 'web_api'">
                        <group>
                            <field name="last_sync_at"/>
                            <field name="last_sync_period"/>
                        </group>
                        <group>
                            <field name="last_sync_device_log_count"/>
                            <field name="last_sync_daily_rows"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Connection" name="connection">
                            <group>
                                <group string="Organisation">
                                    <field name="company_id" groups="base.group_multi_company"/>
                                    <field name="address_id"/>
                                </group>
                                <group string="How attendance is loaded">
                                    <field name="connection_mode" widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="attendance_tz"
                                           placeholder="Asia/Kolkata"
                                           help="Wall clock used for LogDate without timezone offset."/>
                                </group>
                            </group>

                            <separator string="Web API — GetDeviceLogs JSON"
                                       invisible="connection_mode != 'web_api'"/>
                            <div class="text-muted mb-2" invisible="connection_mode != 'web_api'">
                                Each <code>EmployeeCode</code> must match the employee's
                                <b>Employee Code</b> or <b>Identification No.</b> in Odoo.
                                Rows use <code>LogDate</code>
                                (<code>YYYY-MM-DD HH:MM:SS</code>),
                                optional <code>SerialNumber</code>,
                                <code>PunchDirection</code>
                                (<code>in</code>/<code>out</code> or blank for undirected),
                                plus <code>Temperature</code> / <code>TemperatureState</code> (ignored for matching).
                            </div>
                            <group invisible="connection_mode != 'web_api'">
                                <group>
                                    <field name="web_api_base_url"
                                           placeholder="http://host:port"/>
                                    <field name="web_api_key" password="True"/>
                                </group>
                                <group>
                                    <field name="web_api_days_back"/>
                                    <field name="web_api_serial_filter"
                                           placeholder="Leave empty for all readers"/>
                                    <field name="web_api_ignored_employee_codes"
                                           placeholder="Comma or line list, e.g. 8888, 99999, 999999"
                                           colspan="2"/>
                                </group>
                            </group>

                            <separator string="ZK TCP device" invisible="connection_mode != 'zk'"/>
                            <group invisible="connection_mode != 'zk'">
                                <group>
                                    <field name="device_ip"/>
                                    <field name="port_number"/>
                                </group>
                            </group>

                            <separator string="Diagnostics"/>
                            <button name="action_test_connection"
                                    type="object"
                                    string="Test connection"
                                    class="btn-link ps-0"
                                    icon="fa-plug"/>
                        </page>

                        <page string="Consolidated preview" name="preview">
                            <field name="attendance_data" nolabel="1" readonly="1"
                                   placeholder="Run a sync to see one row per employee per work day (first in / last out)."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="biometric_device_details_action" model="ir.actions.act_window">
        <field name="name">Biometric devices</field>
        <field name="res_model">biometric.device.details</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Connect a ZK reader or a Web API that returns GetDeviceLogs-style JSON.
            </p>
        </field>
    </record>
</odoo>
