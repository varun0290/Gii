<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="probation_date_mail_template" model="mail.template">
            <field name="name">Probation Date Mail Template</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="email_from">{{ctx.get('email_from')}}</field>
            <field name="email_to">{{ctx.get('email_to')}}</field>
            <field name="subject">Probation Date Mail</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear <t t-out="ctx.get('hr_manager_name', '')"/>,</p>
                    <p>
                        List of employees who has completed there probation period:
                        <t t-out="ctx.get('employee_names', '')"/>
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>
