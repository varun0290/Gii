<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_hr_contribution_tree" model="ir.ui.view">
        <field name="name">hr.contribution.tree</field>
        <field name="model">hr.contribution</field>
        <field name="arch" type="xml">
            <tree string="Employee Contributions">
                <field name="employee_id"/>
                <field name="date" string="Contribution Date"/>
                <field name="contribution_month"/>
                <field name="employee_share" sum="Total Employee Share"/>
                <field name="employer_share" sum="Total Employer Share"/>
                <field name="total" sum="Grand Total"/>
                <field name="contribution_type"/>
                <field name="department_id"/>
            </tree>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_hr_contribution_pivot" model="ir.ui.view">
        <field name="name">hr.contribution.pivot</field>
        <field name="model">hr.contribution</field>
        <field name="arch" type="xml">
            <pivot string="Contribution Report">
                <field name="employee_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="employee_share" type="measure"/>
                <field name="employer_share" type="measure"/>
                <field name="total" type="measure"/>
                <field name="contribution_type" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hr_contribution_form" model="ir.ui.view">
        <field name="name">hr.contribution.form</field>
        <field name="model">hr.contribution</field>
        <field name="arch" type="xml">
            <form string="Employee Contribution">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="date"/>
                            <field name="contribution_type"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="employee_share"/>
                            <field name="employer_share"/>
                            <field name="total"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hr_contribution_search" model="ir.ui.view">
        <field name="name">hr.contribution.search</field>
        <field name="model">hr.contribution</field>
        <field name="arch" type="xml">
            <search string="Search Contributions">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="contribution_type"/>
                <field name="date"/>
                <separator/>
                <filter string="Date" name="date_filter" date="date"/>
                <separator/>
                <filter string="GOSI" name="gosi" domain="[('contribution_type', '=', 'gosi')]"/>
                <filter string="Pension" name="pension" domain="[('contribution_type', '=', 'pension')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by':'employee_id'}"/>
                    <filter string="Department" name="group_department" context="{'group_by':'department_id'}"/>
                    <filter string="Contribution Type" name="group_type" context="{'group_by':'contribution_type'}"/>
                    <filter string="Month" name="group_month" context="{'group_by':'date:month'}"/>
                    <filter string="Year" name="group_year" context="{'group_by':'date:year'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_contribution" model="ir.actions.act_window">
        <field name="name">Employee Contributions</field>
        <field name="res_model">hr.contribution</field>
        <field name="view_mode">tree,pivot,form</field>
        <field name="search_view_id" ref="view_hr_contribution_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new contribution record
            </p>
        </field>
    </record>

    <!-- Menuitem -->
    <menuitem id="menu_hr_contribution"
        name="Contributions"
        parent="menu_hr_employee_cost_root"
        action="action_hr_contribution"
        sequence="5"
    />
</odoo>
