<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_hr_employee_cost_root"
        name="Employee Costs"
        sequence="45"
        parent="hr.menu_hr_root"
    />
    <record id="action_hr_employee_cost" model="ir.actions.act_window">
        <field name="name">Employee Costs</field>
        <field name="res_model">hr.employee.cost</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>
    <menuitem id="menu_hr_employee_cost_list"
        name="All Costs"
        parent="menu_hr_employee_cost_root"
        action="action_hr_employee_cost"
        sequence="1"
    />
    <record id="action_hr_employee_cost_dashboard" model="ir.actions.act_window">
        <field name="name">Cost to Hire Dashboard</field>
        <field name="res_model">hr.employee.cost</field>
        <field name="view_mode">pivot,list,graph</field>
        <field name="view_id" ref="view_hr_employee_cost_pivot"/>
        <field name="context">{}</field>
    </record>
    <menuitem id="menu_hr_employee_cost_dashboard"
        name="Cost Dashboard"
        parent="menu_hr_employee_cost_root"
        action="action_hr_employee_cost_dashboard"
        sequence="2"
    />
    <record id="action_hr_cost_centre" model="ir.actions.act_window">
        <field name="name">Cost Centres</field>
        <field name="res_model">hr.cost.centre</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_hr_cost_centre"
        name="Cost Centres"
        parent="menu_hr_employee_cost_root"
        action="action_hr_cost_centre"
        sequence="10"
    />
</odoo>
