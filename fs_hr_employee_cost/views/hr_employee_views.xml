<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_form_costs" model="ir.ui.view">
        <field name="name">hr.employee.form.costs</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_employee_costs"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    groups="hr.group_hr_user">
                    <field name="employee_cost_count" widget="statinfo" string="Costs"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='hr_settings']" position="after">
                <page string="Employee Costs" name="employee_costs" groups="hr.group_hr_user">
                    <field name="employee_cost_ids">
                        <tree string="Costs" create="0" delete="0" editable="bottom">
                            <field name="name"/>
                            <field name="cost_type"/>
                            <field name="amount"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="department_id"/>
                            <field name="cost_centre_id"/>
                            <field name="effective_date"/>
                            <field name="state" widget="badge"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
