<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_cost_search" model="ir.ui.view">
        <field name="name">hr.employee.cost.search</field>
        <field name="model">hr.employee.cost</field>
        <field name="arch" type="xml">
            <search string="Employee Costs">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="cost_type"/>
                <field name="department_id"/>
                <field name="cost_centre_id"/>
                <field name="effective_date"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Waiting Approval" name="wait_hr" domain="[('state', '=', 'wait_hr')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="Hiring" name="hiring" domain="[('cost_type', '=', 'hiring')]"/>
                <filter string="Renewal" name="renewal" domain="[('cost_type', '=', 'renewal')]"/>
                <filter string="Medical" name="medical" domain="[('cost_type', 'in', ['medical_self', 'medical_family'])]"/>
                <filter string="Cost to Hire" name="cost_to_hire" domain="[('cost_type', '=', 'hiring')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_cost_type" string="Cost Type" context="{'group_by': 'cost_type'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_cost_centre" string="Cost Centre" context="{'group_by': 'cost_centre_id'}"/>
                    <filter name="group_effective_date" string="Effective Date" context="{'group_by': 'effective_date'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_hr_employee_cost_tree" model="ir.ui.view">
        <field name="name">hr.employee.cost.tree</field>
        <field name="model">hr.employee.cost</field>
        <field name="arch" type="xml">
            <tree string="Employee Costs">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="cost_type"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="department_id"/>
                <field name="cost_centre_id"/>
                <field name="effective_date"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state == 'wait_hr'" decoration-danger="state == 'rejected'" decoration-muted="state == 'draft'"/>
            </tree>
        </field>
    </record>
    <record id="view_hr_employee_cost_form" model="ir.ui.view">
        <field name="name">hr.employee.cost.form</field>
        <field name="model">hr.employee.cost</field>
        <field name="arch" type="xml">
            <form string="Employee Cost">
                <header>
                    <button name="action_submit_for_approval" string="Submit for Approval" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_approve" string="Approve" type="object" invisible="state != 'wait_hr'" class="oe_highlight" groups="fs_hr_contract.group_head_of_hr"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state != 'wait_hr'" groups="fs_hr_contract.group_head_of_hr"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state == 'draft'" groups="fs_hr_contract.group_head_of_hr"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="state" widget="statusbar" statusbar_visible="draft,wait_hr,approved,rejected"/>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_id" readonly="state not in ('draft', 'rejected')"/>
                            <field name="cost_type" readonly="state not in ('draft', 'rejected')"/>
                            <field name="amount" readonly="state not in ('draft', 'rejected')"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="effective_date" readonly="state not in ('draft', 'rejected')"/>
                        </group>
                        <group>
                            <field name="department_id" readonly="state not in ('draft', 'rejected')"/>
                            <field name="cost_centre_id" readonly="state not in ('draft', 'rejected')"/>
                            <field name="state" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_hr_employee_cost_pivot" model="ir.ui.view">
        <field name="name">hr.employee.cost.pivot</field>
        <field name="model">hr.employee.cost</field>
        <field name="arch" type="xml">
            <pivot string="Cost to Hire Dashboard" sample="1">
                <field name="amount" type="measure"/>
                <field name="employee_id" type="row"/>
                <field name="cost_type" type="row"/>
                <field name="department_id" type="col"/>
                <field name="cost_centre_id" type="col"/>
                <field name="effective_date" interval="month" type="col"/>
            </pivot>
        </field>
    </record>
    <record id="view_hr_employee_cost_graph" model="ir.ui.view">
        <field name="name">hr.employee.cost.graph</field>
        <field name="model">hr.employee.cost</field>
        <field name="arch" type="xml">
            <graph string="Cost by Department" type="bar" sample="1">
                <field name="department_id"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>
</odoo>
