<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_probation_period_review_confirmed_doc">
        <t t-call="fs_giluat_reports.external_layout">
            <div class="page" style="font-family: Arial !important;">
                <style>
                    .fw-900 {
                        font-weight: 900 !important;
                    }
                    .text-justify {
                        text-align: justify;
                    }
                    .bcb {
                        border-color: black !important;
                    }
                </style>
                <p class="p-0 m-0 mb-5 text-justify">
                    Date: <span t-esc="datetime.date.today()" t-options="{'widget': 'date', 'format': 'dd/MM/YYYY'}"/>
                </p>
                <p class="p-0 m-0 mb-4 text-justify">To: <span t-esc="safe_employee_name[o.id]"/>,</p>
                <h5 class="fw-900 p-0 m-0 mb-4">Subject: Probation Period Review - Confirmed</h5>
                <p class="p-0 m-0 mb-2 text-justify">Dear: <span t-esc="safe_employee_name[o.id]"/>,</p>
                <p class="p-0 m-0 mb-2 text-justify">
                    Congratulations! I am pleased to confirm that you have successfully completed your 3 or 6 month probationary period.
                </p>
                <p class="p-0 m-0 mb-2 text-justify">
                    <t t-if="is_with_changes">
                        As per your employment agreement conditions tied to the successful completion of your probationary period, your monthly total salary has been updated effective <span t-esc="datetime.date.today()" t-options="{'widget': 'date', 'format': 'dd/MM/YYYY'}"/>. The new details are reflected below:
                    </t>
                    <t t-else="">
                        All current conditions within your employment agreement with our firm remain unchanged.
                    </t>
                </p>
                <table class="mx-5 py-3 table table-sm table-borderless" t-if="is_with_changes and o">
                    <tr>
                        <td class="w-50 px-0 mx-0">Basic Salary:</td>
                        <td class="w-50 px-0 mx-0">
                            <span t-field="o.wage"/>
                            <span t-if="o.wage_type == 'monthly'"> / per month</span>
                            <span t-if="o.wage_type == 'hour'"> / per hour</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="w-50 px-0 mx-0">Housing Allowance:</td>
                        <td class="w-50 px-0 mx-0">
                            <span t-field="o.l10n_ae_housing_allowance"/>
                            <span t-if="o.wage_type == 'monthly'"> / per month</span>
                            <span t-if="o.wage_type == 'hour'"> / per hour</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="w-50 px-0 mx-0">Other Allowances:</td>
                        <td class="w-50 px-0 mx-0">
                            <span t-field="o.l10n_ae_other_allowances"/>
                            <span t-if="o.wage_type == 'monthly'"> / per month</span>
                            <span t-if="o.wage_type == 'hour'"> / per hour</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="w-50 px-0 mx-0">New Total Gross Salary:</td>
                        <td class="w-50 px-0 mx-0">
                            <span t-esc="o.wage + o.l10n_ae_housing_allowance + o.l10n_ae_other_allowances"
                                t-options="{'widget': 'monetary', 'display_currency': o.currency_id}" />
                            <span t-if="o.wage_type == 'monthly'"> / per month</span>
                            <span t-if="o.wage_type == 'hour'"> / per hour</span>
                        </td>
                    </tr>
                </table>
                <p class="p-0 m-0 mb-2 text-justify">
                    <t t-if="is_with_changes">
                        Congratulations again and we wish you continued success at our firm.
                    </t>
                    <t t-else="">
                        Congratulations again and we wish you continued success at our company.
                    </t>
                </p>
                <p class="p-0 m-0 mb-2 text-justify">
                    Yours sincerely,
                </p>
                <table class="table table-sm table-borderless">
                    <tr>
                        <td class="w-50 p-0 m-0">
                            <p class="p-0 m-0 mt-4">For and on behalf of</p>
                            <p class="p-0 m-0 fw-900" t-field="o.company_id"/>
                            <p class="p-0 m-0 mt-5 pt-5 fw-900">
                                <span class="border-top bcb pt-1">Human Resources Department and Signature</span>
                            </p>
                        </td>
                        <td class="w-50 bcb">
                            <p class="p-0 m-0 text-center fw-900">
                                <br/><br/><br/><br/><br/><br/>
                                <span class="border-top bcb p-0 m-0 pt-1" t-esc="safe_employee_name[o.id]"/>
                            </p>
                        </td>
                    </tr>
                </table>
            </div>
        </t>
    </template>
    <template id="prob_pdf_wchg">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="fs_giluat_reports.report_probation_period_review_confirmed_doc"/>
            </t>
        </t>
    </template>
    <template id="prob_pdf_nochg">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="fs_giluat_reports.report_probation_period_review_confirmed_doc"/>
            </t>
        </t>
    </template>
</odoo>
