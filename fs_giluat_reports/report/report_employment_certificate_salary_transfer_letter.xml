<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_employment_certificate_salary_transfer_letter_doc">
        <t t-call="fs_giluat_reports.external_layout">
            <div class="page" style="font-family: Arial !important;">
                <style>
                    .fw-900 {
                        font-weight: 900 !important;
                    }
                    .text-justify {
                        text-align: justify;
                    }
                </style>
                <p class="p-0 m-0 mb-2 text-justify" t-esc="datetime.date.today()" t-options="{'widget': 'date', 'format': 'dd.MM.YYYY'}"/>
                <t t-if="o.agent_id">
                    <div class="mb-4">
                        <p class="p-0 m-0" t-field="o.agent_id"/>
                        <p class="p-0 m-0" t-if="o.agent_id.street" t-esc="o.agent_id.street"/>
                        <p class="p-0 m-0" t-if="o.agent_id.street2" t-esc="o.agent_id.street2"/>
                        <p class="p-0 m-0" t-if="o.agent_id.city" t-esc="o.agent_id.city"/>
                        <t t-if="o.agent_id.state and o.agent_id.zip">
                            <p class="p-0 m-0">
                                <span t-field="o.agent_id.state"/>
                                -
                                <span t-esc="o.agent_id.zip"/>
                            </p>
                        </t>
                        <t t-elif="o.agent_id.state and not o.agent_id.zip">
                            <p class="p-0 m-0" t-field="o.agent_id.state"/>
                        </t>
                        <t t-elif="not o.agent_id.state and o.agent_id.zip">
                            <p class="p-0 m-0" t-field="o.agent_id.zip"/>
                        </t>
                        <p class="p-0 m-0" t-if="o.agent_id.country" t-field="o.agent_id.country"/>
                    </div>
                </t>
                <p class="mb-4">Dear Sirs,</p>
                <h5 class="fw-900 p-0 m-0 mb-4">Subject: Employment Certificate/Salary Transfer Letter</h5>
                <p class="p-0 m-0 mb-2 text-justify">Dear Sir,</p>
                <p class="p-0 m-0 mb-2 text-justify">
                    This is to certify that <span t-field="o.name"/>, holder of  <span t-field="o.country_id"/> passport number <span class="fw-900" t-field="o.passport_id"/> is working with <span t-field="o.company_id"/> since <span t-field="o.joining_date" t-options="{'widget': 'date', 'format': 'dd/MM/YYYY'}"/> as <span t-field="o.job_id"/>.
                    His/her monthly gross salary is <span t-if="o.contract_id" t-field="o.contract_id.wage"/>.
                </p>
                <p class="p-0 m-0 mb-2 text-justify">
                    We are aware that <span t-field="o.name"/> has availed a loan from your bank and we are under instruction from her to credit her salary to her Bank Account number <span t-field="o.bank_account_id"/> with yourselves every month starting from  <span t-field="o.joining_date" t-options="{'widget': 'date', 'format': 'dd/MM/YYYY'}"/>.  We undertake not to transfer the salary to any other Bank until we receive a clearance certificate issued by you.
                </p>
                <p class="p-0 m-0 mb-2 text-justify">
                    We further confirm, in case <span t-field="o.name"/> leaves, <span t-field="o.company_id"/> or is terminated, for any reason the end of service benefits, if any, will be transferred to the aforesaid account unless a clearance certificate is issued by the Bank.
                </p>
                <p class="p-0 m-0 mb-2 text-justify">
                    Please note that this letter does not constitute a guarantee on our part towards repayment of Loan/ Overdraft / Credit Card.
                </p>
                <p class="p-0 m-0 mb-2 text-justify">
                    This certificate is issued upon the employee's request and <span t-field="o.company_id"/> shall not be liable for any claim arising from any transaction resulting from the use of this document.
                </p>
                <p class="p-0 m-0 mb-2 text-justify">Yours faithfully,</p>
                <p class="p-0 m-0 mt-4 text-justify">On behalf of <span t-field="o.company_id"/></p>
                <p class="p-0 m-0 mt-5 pt-5 fw-900">Chief Financial Officer</p>
                <p class="p-0 m-0 mb-2 text-justify">Group General Manager</p>
            </div>
        </t>
    </template>
    <template id="report_employment_certificate_salary_transfer_letter">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="False"/>
                <t t-if="o.user_id and o.user_id.partner_id">
                    <t t-set="lang" t-value="o.user_id.partner_id.sudo().lang"/>
                </t>
                <t t-call="fs_giluat_reports.report_employment_certificate_salary_transfer_letter_doc" t-lang="lang"/>
            </t>
        </t>
    </template>
</odoo>
