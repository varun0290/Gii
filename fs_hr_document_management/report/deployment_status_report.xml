<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_deployment_status" model="ir.actions.report">
        <field name="name">Deployment Status</field>
        <field name="model">hr.document.deployment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fs_hr_document_management.report_deployment_status_doc</field>
        <field name="report_file">fs_hr_document_management.report_deployment_status_doc</field>
    </record>
    <template id="report_deployment_status_doc">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page">
                    <h2>Deployment Status: <span t-field="o.name"/></h2>
                    <p>Template: <span t-field="o.template_id.name"/></p>
                    <p>Effective Date: <span t-field="o.effective_date" t-options="{'widget': 'date'}"/></p>
                    <p>State: <span t-field="o.state"/></p>
                    <h3>Lines</h3>
                    <table class="table table-sm">
                        <tr>
                            <th>Employee</th>
                            <th>Status</th>
                            <th>Sent</th>
                            <th>Viewed</th>
                            <th>Signed</th>
                        </tr>
                        <t t-foreach="o.line_ids" t-as="line">
                            <tr>
                                <td><span t-field="line.employee_id.name"/></td>
                                <td><span t-field="line.state"/></td>
                                <td><span t-field="line.sent_datetime" t-options="{'widget': 'datetime'}"/></td>
                                <td><span t-field="line.viewed_datetime" t-options="{'widget': 'datetime'}"/></td>
                                <td><span t-field="line.signed_datetime" t-options="{'widget': 'datetime'}"/></td>
                            </tr>
                        </t>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
