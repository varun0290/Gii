<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_document_template_body" model="ir.actions.report">
        <field name="name">HR Document (Custom Body)</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fs_hr_document_management.report_document_template_body</field>
        <field name="report_file">fs_hr_document_management.report_document_template_body</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_document_template_body">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="font-size:14px; font-family: Arial;">
                    <t t-raw="body"/>
                </div>
            </t>
        </t>
    </template>
</odoo>
