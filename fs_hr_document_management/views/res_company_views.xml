<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_company_form_documents" model="ir.ui.view">
        <field name="name">res.company.form.documents</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_registry']" position="after">
                <field name="document_signing_authority_id"/>
                <field name="document_legal_text"/>
                <field name="document_stamp_image" widget="image" options="{'size': [100, 100]}"/>
            </xpath>
        </field>
    </record>
</odoo>
