<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_form_documents" model="ir.ui.view">
        <field name="name">hr.employee.form.documents</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="after">
                <page string="Documents" name="hr_documents">
                    <field name="document_deployment_line_ids">
                        <tree string="Deployments" create="0" delete="0">
                            <field name="deployment_id"/>
                            <field name="state" widget="badge"/>
                            <field name="sent_datetime"/>
                            <field name="viewed_datetime"/>
                            <field name="signed_datetime"/>
                        </tree>
                    </field>
                    <field name="signed_document_ids">
                        <tree string="Signed Documents" create="0" delete="0">
                            <field name="template_id"/>
                            <field name="signed_datetime"/>
                            <field name="attachment_id"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
