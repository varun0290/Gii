<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_inherit_payroll_cutoff" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.payroll.cutoff</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='hr_payroll_settings']" position="inside">
                <setting id="salary_join_cutoff_day"
                         string="Salary payment join cut-off"
                         help="Join day on/before → first salary in the same calendar month; after → first salary next month."
                         title="Typical default 20. Calendar day from 1 to 31 for the company's rule.">
                    <field name="salary_join_cutoff_day" class="w-25"/>
                    <span class="text-muted">Day of month</span>
                </setting>
                <setting id="payroll_booking_cutoff_day_setting"
                         string="Payroll booking cut-off"
                         help="Second cut-off used with the rule above when previewing booking vs salary month on contracts (not accounting posting)."
                         title="Typical default 25. For HR previews on the contract; adjust with your payroll policy.">
                    <field name="payroll_booking_cutoff_day" class="w-25"/>
                    <span class="text-muted">Day of month</span>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
