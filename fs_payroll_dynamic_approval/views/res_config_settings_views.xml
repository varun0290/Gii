<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_inherit_payroll_cutoff" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.payroll.cutoff</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='hr_payroll_settings']" position="inside">
                <setting string="Salary Cut-off Day" id="salary_cutoff_day"
                    help="Join on/before this day → paid same month. Join after → paid next month. Default: 25.">
                    <field name="salary_cutoff_day" class="w-25"/><span>of month</span>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
